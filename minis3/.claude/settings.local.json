      "Bash(curl -s -o /dev/null -w \"put object: %{http_code}\\\\n\" -X PUT --data-binary @/tmp/m3-up.txt -H \"Content-Length: 12\" http://localhost:18080/test-bucket/hello.txt)",
      "Bash(curl -s -o /dev/null -w \"list objects: %{http_code}\\\\n\" http://localhost:18080/test-bucket)",
      "Bash(pkill -f \"minis3 -p 18080\")",
      "Bash(curl -s -o /dev/null -w \"list buckets:    %{http_code}\\\\n\" http://localhost:18080/)",
      "Bash(curl -s -o /dev/null -w \"create bucket:   %{http_code}\\\\n\" -X PUT http://localhost:18080/test-bucket)",
      "Bash(curl -s -o /dev/null -w 'put object:      %{http_code}\\\\n' -X PUT --data-binary @/tmp/m3-up.txt -H 'Content-Length: __TRACKED_VAR__' http://localhost:18080/test-bucket/hello.txt)",
      "Bash(curl -s -o /dev/null -w \"list objects:    %{http_code}\\\\n\" http://localhost:18080/test-bucket)",
